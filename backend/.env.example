# Stripe secret key (sk_test_... / sk_live_...). Required for real payments;
# if empty, the server falls back to an in-memory fake payment provider.
AL_STRIPE_SECRET_KEY=

# Stripe webhook signing secret (whsec_...). Optional for local dev: enables
# the POST /payments/webhook signature verification. Without it the webhook
# endpoint returns 501 but ConfirmBooking still works (it queries Stripe
# directly via VerifyPayment).
AL_STRIPE_WEBHOOK_SECRET=
